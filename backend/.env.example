APP_ENV=development
APP_NAME="RepoLens API"
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here
DATABASE_URL=postgresql+asyncpg://repolens:repolens@localhost:5433/repolens
CORS_ORIGINS=["http://localhost:3000"]
# Optional: GitHub personal access token for higher API rate limits
GITHUB_TOKEN=
# AI provider: "mock" (default, deterministic, no network) or "9router"
AI_PROVIDER=mock
# Required only when AI_PROVIDER=9router
AI_MODEL=
AI_API_KEY=
# Optional; defaults to https://9router.com/v1 when empty
AI_BASE_URL=
